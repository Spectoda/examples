{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.spectoda.com/creator-kit/source-lock.v1.json",
  "title": "Spectoda Creator Kit source lock",
  "type": "object",
  "required": [
    "schemaVersion",
    "exporterVersion",
    "repository",
    "commit",
    "files",
    "assets",
    "documentationBundle",
    "examples"
  ],
  "properties": {
    "schemaVersion": {
      "const": "creator-kit-source-lock.v1"
    },
    "exporterVersion": {
      "type": "string",
      "pattern": "^creator-kit-exporter/[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"
    },
    "repository": {
      "type": "string",
      "minLength": 1
    },
    "commit": {
      "type": "string",
      "anyOf": [
        {
          "pattern": "^[a-f0-9]{40}$"
        },
        {
          "pattern": "^synthetic-[a-z0-9-]+$"
        }
      ]
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "sourcePath",
          "sourceSha256",
          "normalizedSha256",
          "license",
          "publicDerivative",
          "legalTraceabilityStatus",
          "legalTraceability"
        ],
        "properties": {
          "sourcePath": {
            "type": "string"
          },
          "sourceSha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "normalizedSha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "license": {
            "type": "string"
          },
          "publicDerivative": {
            "const": true
          },
          "legalTraceabilityStatus": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "raw_validation_source",
              "validation_draft",
              "approved_for_publication",
              "published_derivative",
              "superseded",
              "not_legal_text",
              null
            ]
          },
          "legalTraceability": {
            "type": [
              "object",
              "null"
            ],
            "required": [
              "sourcePath",
              "sourceCommit",
              "approvalTask",
              "status",
              "publicDerivative",
              "documentationSourcePath",
              "documentationSourceCommit"
            ],
            "properties": {
              "sourcePath": {
                "type": "string",
                "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*%)(?!.*[\\p{Cc}\\p{Cf}])(?!.*(?:^|/)\\.\\.?(?:/|$))[^/]+(?:/[^/]+)*$"
              },
              "sourceCommit": {
                "type": "string",
                "pattern": "^[a-f0-9]{40}$"
              },
              "approvalTask": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "enum": [
                  "approved_for_publication",
                  "published_derivative"
                ]
              },
              "publicDerivative": {
                "const": true
              },
              "documentationSourcePath": {
                "type": "string",
                "minLength": 1
              },
              "documentationSourceCommit": {
                "type": "string",
                "pattern": "^[a-f0-9]{40}$"
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "role",
          "sourcePath",
          "bundlePath",
          "sourceSha256",
          "bundleSha256",
          "license",
          "sourceLock",
          "publicDerivative",
          "firmwareVersion",
          "upstreamRepository",
          "upstreamCommit"
        ],
        "properties": {
          "role": {
            "enum": [
              "controller-config-contract",
              "controller-config-schema"
            ]
          },
          "sourcePath": {
            "type": "string",
            "pattern": "^(?!/)(?!.*\\.\\.(?:/|$)).+\\.json$"
          },
          "bundlePath": {
            "type": "string",
            "pattern": "^assets/(?!.*\\.\\.(?:/|$)).+\\.json$"
          },
          "sourceSha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "bundleSha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "license": {
            "type": "string",
            "minLength": 1
          },
          "sourceLock": {
            "type": "string",
            "minLength": 1
          },
          "publicDerivative": {
            "const": true
          },
          "firmwareVersion": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
          },
          "upstreamRepository": {
            "const": "Spectoda/firmware"
          },
          "upstreamCommit": {
            "type": "string",
            "pattern": "^[a-f0-9]{40}$"
          }
        },
        "additionalProperties": false
      }
    },
    "documentationBundle": {
      "type": "object",
      "required": [
        "repository",
        "commit",
        "exporterVersion",
        "checksumDigest"
      ],
      "properties": {
        "repository": {
          "const": "Spectoda/documentation"
        },
        "commit": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "exporterVersion": {
          "type": "string",
          "minLength": 1
        },
        "checksumDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "additionalProperties": false
    },
    "examples": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": [
          "role",
          "sourcePath",
          "bundlePath",
          "sourceSha256",
          "bundleSha256",
          "license",
          "source"
        ],
        "properties": {
          "role": {
            "enum": [
              "selection",
              "file"
            ]
          },
          "sourcePath": {
            "type": "string",
            "minLength": 1
          },
          "bundlePath": {
            "type": [
              "string",
              "null"
            ]
          },
          "sourceSha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "bundleSha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "license": {
            "const": "MIT"
          },
          "source": {
            "type": "object",
            "required": [
              "repository",
              "commit"
            ],
            "properties": {
              "repository": {
                "const": "Spectoda/examples"
              },
              "commit": {
                "type": "string",
                "pattern": "^[a-f0-9]{40}$"
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
