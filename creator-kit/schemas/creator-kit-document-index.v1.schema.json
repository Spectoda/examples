{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.spectoda.com/creator-kit/document-index.v1.json",
  "title": "Spectoda Creator Kit document index",
  "type": "object",
  "required": ["schemaVersion", "documents"],
  "properties": {
    "schemaVersion": { "const": "creator-kit-document-index.v1" },
    "documents": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "path", "title", "summary", "sha256"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "summary": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
