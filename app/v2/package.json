{
  "name": "@spectoda/examples-app-v2",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "bun@1.4.2",
  "scripts": {
    "dev": "bun ./node_modules/vite/bin/vite.js --mode filesystem-v2",
    "build": "tsc -b && bun ./node_modules/vite/bin/vite.js build",
    "preview": "bun ./node_modules/vite/bin/vite.js preview",
    "typecheck": "tsc -b",
    "lint": "biome check .",
    "format": "biome check --write .",
    "check": "bun run typecheck && bun run lint",
    "check:prepared": "bun run prepared.ts",
    "test": "bun test"
  },
  "dependencies": {
    "@lazurio/module-kit": "github:Lazurio/module-kit#v0.1.0",
    "dompurify": "^3.2.4",
    "marked": "^14.1.4",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "yaml": "^2.8.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.15",
    "@types/bun": "^1.4.2",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.0",
    "typescript": "~5.9.3",
    "vite": "^8.0.0"
  },
  "lazurio": {
    "runtime": {
      "schema_version": "lazurio.runtime.v1",
      "id": "spectoda-examples-v2",
      "title": "Examples v2",
      "company": "Spectoda",
      "module": "examples",
      "surface": "public-preview",
      "dev_script": "dev",
      "build_script": "build",
      "tags": [
        "examples",
        "filesystem-db-v2",
        "public-preview"
      ],
      "listeners": [
        {
          "id": "app",
          "role": "entrypoint",
          "lease": "main",
          "protocol": "http",
          "health": {
            "kind": "http",
            "path": "/"
          }
        }
      ]
    },
    "preparation": {
      "schema_version": "lazurio.preparation.v1",
      "owner_package": "app/v2/package.json",
      "check_script": "check:prepared"
    }
  }
}
